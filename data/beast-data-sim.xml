    <sequence taxon="rGyalrongMaerkang">?</sequence>
  </data>
  <!-- specify the tree -->
  <tree id="tree" spec="beast.util.TreeParser" newick="xyz" taxa="@alignment"/>
  <!-- configure the Sequence Simulator -->
  <run spec="beast.app.seqgen.SequenceSimulator" id="seqgen" data="@alignment" tree="@tree" sequencelength="3000" outputFileName="output_name">
    <!-- set up site model -->
    <siteModel spec="SiteModel" id="siteModel" gammaCategoryCount="4">
      <!-- specify gamma shape parameter -->
      <shape spec="parameter.RealParameter">1.0</shape>
      <!-- use CTMC substitution model with custom rates -->
      <substModel id="CTMC" spec="GeneralSubstitutionModel">
        <!-- rates: pi1 (0->1, naissance) et pi0 (1->0, mort) -->
        <parameter id="rates" spec="parameter.RealParameter" dimension="2" estimate="false" lower="0.0" name="rates">0.05695 0.94305</parameter>
        <frequencies id="freqs" spec="Frequencies">
          <data idref="alignment"/>
        </frequencies>
      </substModel>
    </siteModel>
    <!-- use a strict clock -->
    <branchRateModel id="StrictClock" spec="beast.evolution.branchratemodel.StrictClockModel">
      <parameter dimension="1" estimate="false" id="clockRate" minordimension="1" name="clock.rate" value="1.0"/>
    </branchRateModel>
  </run>
</beast>
